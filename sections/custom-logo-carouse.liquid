{%- style -%}
  .logo-carousel-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }
  .logo-carousel-{{ section.id }} .section-heading {
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    margin-bottom: 8px;
  }
  .logo-carousel-{{ section.id }} .section-subheading {
    text-align: center;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 15px;
    margin-bottom: 36px;
  }
  .logo-carousel-{{ section.id }} .logo-track-wrapper {
    position: relative;
    width: 100%;
  }
  .logo-carousel-{{ section.id }} .logo-track-wrapper::before,
  .logo-carousel-{{ section.id }} .logo-track-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  {% if section.settings.show_fade %}
  .logo-carousel-{{ section.id }} .logo-track-wrapper::before {
    left: 0;
    background: linear-gradient(to right, rgba(var(--color-background), 1), rgba(var(--color-background), 0));
  }
  .logo-carousel-{{ section.id }} .logo-track-wrapper::after {
    right: 0;
    background: linear-gradient(to left, rgba(var(--color-background), 1), rgba(var(--color-background), 0));
  }
  {% endif %}
  .logo-carousel-{{ section.id }} .logo-track {
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    animation: logoScroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    width: max-content;
  }
  .logo-carousel-{{ section.id }} .logo-track:hover {
    animation-play-state: {{ section.settings.pause_on_hover | default: 'running' }};
  }
  @keyframes logoScroll-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  {% if section.settings.direction == 'right' %}
  .logo-carousel-{{ section.id }} .logo-track {
    animation-direction: reverse;
  }
  {% endif %}
  .logo-carousel-{{ section.id }} .logo-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: {{ section.settings.logo_height }}px;
    {% if section.settings.grayscale %}
      filter: grayscale(100%);
      opacity: 0.5;
      transition: filter 0.3s, opacity 0.3s;
    {% endif %}
  }
  .logo-carousel-{{ section.id }} .logo-item:hover {
    filter: grayscale(0%);
    opacity: 1;
  }
  .logo-carousel-{{ section.id }} .logo-item img {
    height: 100%;
    width: auto;
    max-width: {{ section.settings.logo_max_width }}px;
    object-fit: contain;
  }
{%- endstyle -%}

<div class="logo-carousel-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="logo-track-wrapper">
    <div class="logo-track">
      {%- for block in section.blocks -%}
        <div class="logo-item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- endif -%}
          {%- if block.settings.logo != blank -%}
            <img src="{{ block.settings.logo | image_url: height: 200 }}" alt="{{ block.settings.alt_text | default: 'Partner logo' }}" loading="lazy" height="{{ section.settings.logo_height }}">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
      {%- comment -%}Duplicate for seamless loop{%- endcomment -%}
      {%- for block in section.blocks -%}
        <div class="logo-item" aria-hidden="true">
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener" tabindex="-1">{%- endif -%}
          {%- if block.settings.logo != blank -%}
            <img src="{{ block.settings.logo | image_url: height: 200 }}" alt="" loading="lazy" height="{{ section.settings.logo_height }}">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Logo Carousel",
  "tag": "section",
  "class": "section-logo-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted By"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Brands that trust us"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width",
      "min": 80,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between logos",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale logos (color on hover)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fade",
      "label": "Show edge fade",
      "default": true
    },
    {
      "type": "select",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "options": [
        { "value": "paused", "label": "Yes" },
        { "value": "running", "label": "No" }
      ],
      "default": "paused"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Partner logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Carousel",
      "category": "Social proof",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}

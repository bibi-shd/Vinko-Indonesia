{%- style -%}
  .features-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .features-section-{{ section.id }} .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.gap }}px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  @media screen and (min-width: 750px) {
    .features-section-{{ section.id }} .features-grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }
  .features-section-{{ section.id }} .feature-card {
    text-align: {{ section.settings.text_alignment }};
    padding: {{ section.settings.card_padding }}px;
    border-radius: {{ section.settings.card_radius }}px;
    {% if section.settings.show_card_border %}
      border: 1px solid rgba(var(--color-foreground), 0.1);
    {% endif %}
    {% if section.settings.show_card_bg %}
      background: rgba(var(--color-foreground), 0.02);
    {% endif %}
    transition: transform 0.3s ease;
  }
  .features-section-{{ section.id }} .feature-card:hover {
    transform: translateY(-4px);
  }
  .features-section-{{ section.id }} .feature-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin-bottom: 16px;
    {% if section.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }
  .features-section-{{ section.id }} .feature-icon-wrapper {
    width: {{ section.settings.icon_size | plus: 24 }}px;
    height: {{ section.settings.icon_size | plus: 24 }}px;
    border-radius: {{ section.settings.icon_radius }}px;
    background: {{ section.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    {% if section.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }
  .features-section-{{ section.id }} .feature-icon-wrapper svg,
  .features-section-{{ section.id }} .feature-icon-wrapper img {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
  }
  .features-section-{{ section.id }} .feature-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.3;
  }
  .features-section-{{ section.id }} .feature-description {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.65);
  }
  .features-section-{{ section.id }} .section-heading {
    text-align: center;
    margin-bottom: 12px;
    font-size: {{ section.settings.heading_size }}px;
  }
  .features-section-{{ section.id }} .section-subheading {
    text-align: center;
    margin-bottom: 48px;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 16px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
{%- endstyle -%}

<div class="features-section-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="features-grid">
      {%- for block in section.blocks -%}
        <div class="feature-card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="feature-icon-wrapper">
              <img src="{{ block.settings.icon | image_url: width: 128 }}" alt="{{ block.settings.title }}" loading="lazy">
            </div>
          {%- elsif block.settings.emoji != blank -%}
            <div class="feature-icon-wrapper" style="font-size: {{ section.settings.icon_size }}px;">
              {{ block.settings.emoji }}
            </div>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="feature-title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="feature-description">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Highlights",
  "tag": "section",
  "class": "section-features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need, nothing you don't"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "icon_radius",
      "label": "Icon background radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon background color",
      "default": "#F3F4F6"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_card_border",
      "label": "Show card border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_bg",
      "label": "Show card background",
      "default": false
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji (fallback if no icon)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Crafted with the finest materials for lasting durability and comfort."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Highlights",
      "category": "Content",
      "blocks": [
        { "type": "feature", "settings": { "emoji": "🚀", "title": "Fast Shipping", "description": "Free delivery on all orders over $50. Get it in 2-3 business days." } },
        { "type": "feature", "settings": { "emoji": "🛡️", "title": "Secure Checkout", "description": "Your payment information is always safe and encrypted." } },
        { "type": "feature", "settings": { "emoji": "💎", "title": "Premium Quality", "description": "Crafted with the finest materials for lasting durability." } }
      ]
    }
  ]
}
{% endschema %}

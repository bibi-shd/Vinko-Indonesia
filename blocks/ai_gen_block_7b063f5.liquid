{% doc %}
  @prompt
    create a column image show 3 columns / 1 row on desktop and mobile can add two versions , remove caption, can add column limit 15 column and when not use column can select to close  or open, and can set to center right and left
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-column-images-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-column-images-outer-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-left: {% if block.settings.alignment == 'left' %}0{% elsif block.settings.alignment == 'center' %}auto{% else %}auto{% endif %};
    margin-right: {% if block.settings.alignment == 'right' %}0{% elsif block.settings.alignment == 'center' %}auto{% else %}auto{% endif %};
  }

  .ai-column-images-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    width: 100%;
  }

  .ai-column-images-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-column-images-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-column-images-img-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-column-images-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-column-images-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-column-images-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-column-images-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-column-images-outer-{{ ai_gen_id }}">
    <div class="ai-column-images-container-{{ ai_gen_id }}">
      {% for i in (1..15) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign enabled_key = 'column_' | append: i | append: '_enabled'
          assign image = block.settings[image_key]
          assign enabled = block.settings[enabled_key]
        %}
        
        {% if enabled %}
          <div class="ai-column-images-item-{{ ai_gen_id }}">
            <div class="ai-column-images-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-column-images-img-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-column-images-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>


{% doc %}
  @prompt
    create header banner slider 
    - desktop
    - mobile , can select width 500px to full page and can move text to right left or center, แยก version can add banner desktop and mobile, แยก Content style desktop and mobile version, When open 1 slide >> can open and close arrows and edit width can select full page link 3000px , in the option content style add top center right center left center bottom center bottom left and bottom right and fix max width to show full page 500px to 2600px for desktop and mobile show full page 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign enabled_slides_count = 0
  for i in (1..5)
    assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
    if block.settings[slide_enabled_key]
      assign enabled_slides_count = enabled_slides_count | plus: 1
    endif
  endfor
%}

{% style %}
  .ai-banner-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-banner-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    max-width: {% if block.settings.desktop_content_width == 'full' %}100%{% else %}{{ block.settings.desktop_content_width }}px{% endif %};
    margin: 0 auto;
  }

  .ai-banner-slider__slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
  }

  .ai-banner-slider__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
    pointer-events: none;
  }

  .ai-banner-slider__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-banner-slider__image-desktop-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-banner-slider__image-mobile-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .ai-banner-slider__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-banner-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-banner-slider__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-banner-slider__content-{{ ai_gen_id }} {
    position: absolute;
    {% case block.settings.desktop_content_position %}
      {% when 'top-left' %}
        top: 5%;
        left: 5%;
        transform: none;
        text-align: left;
      {% when 'top-center' %}
        top: 5%;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
      {% when 'top-right' %}
        top: 5%;
        right: 5%;
        transform: none;
        text-align: right;
      {% when 'center-left' %}
        top: 50%;
        left: 5%;
        transform: translateY(-50%);
        text-align: left;
      {% when 'center-center' %}
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
      {% when 'center-right' %}
        top: 50%;
        right: 5%;
        transform: translateY(-50%);
        text-align: right;
      {% when 'bottom-left' %}
        bottom: 5%;
        left: 5%;
        transform: none;
        text-align: left;
      {% when 'bottom-center' %}
        bottom: 5%;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
      {% when 'bottom-right' %}
        bottom: 5%;
        right: 5%;
        transform: none;
        text-align: right;
    {% endcase %}
    color: {{ block.settings.desktop_text_color }};
    width: 90%;
    max-width: 800px;
    z-index: 2;
  }

  .ai-banner-slider__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_title_size }}px;
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-banner-slider__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_subtitle_size }}px;
    margin: 0 0 24px;
  }

  .ai-banner-slider__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    transition: background-color 0.3s ease;
  }

  .ai-banner-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-banner-slider__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-banner-slider__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 3;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }}:hover {
    opacity: 0.8;
    transform: scale(1.2);
  }

  .ai-banner-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.3);
  }

  .ai-banner-slider__arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    display: {% if enabled_slides_count > 1 and block.settings.show_arrows %}flex{% else %}none{% endif %};
    justify-content: space-between;
    padding: 0 20px;
    z-index: 3;
    pointer-events: none;
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, transform 0.3s ease;
    pointer-events: auto;
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
    transform: scale(1.1);
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 749px) {
    .ai-banner-slider__wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
      max-width: 100%;
    }

    .ai-banner-slider__image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-banner-slider__image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-banner-slider__content-{{ ai_gen_id }} {
      {% case block.settings.mobile_content_position %}
        {% when 'top-left' %}
          top: 5%;
          bottom: auto;
          left: 5%;
          right: auto;
          transform: none;
          text-align: left;
        {% when 'top-center' %}
          top: 5%;
          bottom: auto;
          left: 50%;
          right: auto;
          transform: translateX(-50%);
          text-align: center;
        {% when 'top-right' %}
          top: 5%;
          bottom: auto;
          right: 5%;
          left: auto;
          transform: none;
          text-align: right;
        {% when 'center-left' %}
          top: 50%;
          bottom: auto;
          left: 5%;
          right: auto;
          transform: translateY(-50%);
          text-align: left;
        {% when 'center-center' %}
          top: 50%;
          bottom: auto;
          left: 50%;
          right: auto;
          transform: translate(-50%, -50%);
          text-align: center;
        {% when 'center-right' %}
          top: 50%;
          bottom: auto;
          right: 5%;
          left: auto;
          transform: translateY(-50%);
          text-align: right;
        {% when 'bottom-left' %}
          bottom: 5%;
          top: auto;
          left: 5%;
          right: auto;
          transform: none;
          text-align: left;
        {% when 'bottom-center' %}
          bottom: 5%;
          top: auto;
          left: 50%;
          right: auto;
          transform: translateX(-50%);
          text-align: center;
        {% when 'bottom-right' %}
          bottom: 5%;
          top: auto;
          right: 5%;
          left: auto;
          transform: none;
          text-align: right;
      {% endcase %}
      color: {{ block.settings.mobile_text_color }};
    }

    .ai-banner-slider__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-banner-slider__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtitle_size }}px;
    }

    .ai-banner-slider__arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-banner-slider__arrow-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }
  }
{% endstyle %}

<banner-slider-{{ ai_gen_id }}
  class="ai-banner-slider-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  data-total-slides="{{ enabled_slides_count }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-banner-slider__wrapper-{{ ai_gen_id }}">
    <div class="ai-banner-slider__slides-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_image_desktop_key = 'slide_' | append: i | append: '_image_desktop'
          assign slide_image_mobile_key = 'slide_' | append: i | append: '_image_mobile'
          assign slide_title_key = 'slide_' | append: i | append: '_title'
          assign slide_subtitle_key = 'slide_' | append: i | append: '_subtitle'
          assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
          assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign slide_image_desktop = block.settings[slide_image_desktop_key]
          assign slide_image_mobile = block.settings[slide_image_mobile_key]
          assign slide_title = block.settings[slide_title_key]
          assign slide_subtitle = block.settings[slide_subtitle_key]
          assign slide_button_text = block.settings[slide_button_text_key]
          assign slide_button_link = block.settings[slide_button_link_key]
        %}

        {% if slide_enabled %}
          <div
            class="ai-banner-slider__slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
          >
            {% if slide_image_desktop or slide_image_mobile %}
              {% if slide_image_desktop %}
                <img
                  src="{{ slide_image_desktop | image_url: width: 3000 }}"
                  alt="{{ slide_image_desktop.alt | escape }}"
                  loading="lazy"
                  width="{{ slide_image_desktop.width }}"
                  height="{{ slide_image_desktop.height }}"
                  class="ai-banner-slider__image-desktop-{{ ai_gen_id }}"
                >
              {% endif %}

              {% if slide_image_mobile %}
                <img
                  src="{{ slide_image_mobile | image_url: width: 1500 }}"
                  alt="{{ slide_image_mobile.alt | escape }}"
                  loading="lazy"
                  width="{{ slide_image_mobile.width }}"
                  height="{{ slide_image_mobile.height }}"
                  class="ai-banner-slider__image-mobile-{{ ai_gen_id }}"
                >
              {% elsif slide_image_desktop %}
                <img
                  src="{{ slide_image_desktop | image_url: width: 1500 }}"
                  alt="{{ slide_image_desktop.alt | escape }}"
                  loading="lazy"
                  width="{{ slide_image_desktop.width }}"
                  height="{{ slide_image_desktop.height }}"
                  class="ai-banner-slider__image-mobile-{{ ai_gen_id }}"
                >
              {% endif %}
            {% else %}
              <div class="ai-banner-slider__placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
                <div class="ai-banner-slider__empty-state-{{ ai_gen_id }}">
                  Next, add images for slide {{ i }}
                </div>
              </div>
            {% endif %}

            {% if block.settings.show_overlay %}
              <div class="ai-banner-slider__overlay-{{ ai_gen_id }}"></div>
            {% endif %}

            <div class="ai-banner-slider__content-{{ ai_gen_id }}">
              {% if slide_title != blank %}
                <h2 class="ai-banner-slider__title-{{ ai_gen_id }}">{{ slide_title }}</h2>
              {% endif %}

              {% if slide_subtitle != blank %}
                <p class="ai-banner-slider__subtitle-{{ ai_gen_id }}">{{ slide_subtitle }}</p>
              {% endif %}

              {% if slide_button_text != blank and slide_button_link != blank %}
                <a
                  href="{{ slide_button_link }}"
                  class="ai-banner-slider__button-{{ ai_gen_id }}"
                >
                  {{ slide_button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if enabled_slides_count > 1 and block.settings.show_arrows %}
      <div class="ai-banner-slider__arrows-{{ ai_gen_id }}">
        <button
          class="ai-banner-slider__arrow-{{ ai_gen_id }} ai-banner-slider__arrow-prev-{{ ai_gen_id }}"
          aria-label="Previous slide"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          class="ai-banner-slider__arrow-{{ ai_gen_id }} ai-banner-slider__arrow-next-{{ ai_gen_id }}"
          aria-label="Next slide"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}

    {% if enabled_slides_count > 1 and block.settings.show_dots %}
      <div class="ai-banner-slider__controls-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</banner-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-banner-slider__slide-{{ ai_gen_id }}');
        this.totalSlides = this.slides.length;
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

        if (this.totalSlides === 0) return;

        if (this.totalSlides > 1) {
          this.setupControls();
          this.setupArrows();

          if (this.autoplay) {
            this.startAutoplay();
          }

          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => {
            if (this.autoplay) this.startAutoplay();
          });
        }
      }

      setupControls() {
        const controlsContainer = this.querySelector('.ai-banner-slider__controls-{{ ai_gen_id }}');
        if (!controlsContainer) return;

        controlsContainer.innerHTML = '';

        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-banner-slider__dot-{{ ai_gen_id }}');
          if (i === 0) dot.classList.add('active');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          controlsContainer.appendChild(dot);
        }

        this.dots = controlsContainer.querySelectorAll('.ai-banner-slider__dot-{{ ai_gen_id }}');
      }

      setupArrows() {
        const prevButton = this.querySelector('.ai-banner-slider__arrow-prev-{{ ai_gen_id }}');
        const nextButton = this.querySelector('.ai-banner-slider__arrow-next-{{ ai_gen_id }}');

        if (prevButton) {
          prevButton.addEventListener('click', () => this.prevSlide());
        }

        if (nextButton) {
          nextButton.addEventListener('click', () => this.nextSlide());
        }
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.totalSlides;
        this.goToSlide(nextIndex);
      }

      prevSlide() {
        const prevIndex = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('banner-slider-{{ ai_gen_id }}', BannerSlider{{ ai_gen_id }});
  })();
</script>


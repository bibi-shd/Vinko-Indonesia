{% doc %}
  @prompt
    create social media column to show 3 columns on desktop and mobile version 
    - logo or image add on
    - name social media, Desktop width can select to show  100px to full page, add option can to select setting layout left center and right for columns 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

@media screen and (max-width: 749px) {
.ai-social-media-columns-aeutot29wlzfltctdzaigenblockaf7c6e6bx8ulf {
    padding: 40px 20px!important;
}
}
  .ai-social-media-columns-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-social-media-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    width: {{ block.settings.desktop_width_px }}px;
    max-width: 100%;
    {% if block.settings.layout_alignment == 'left' %}
      margin-left: 0;
      margin-right: auto;
    {% elsif block.settings.layout_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.layout_alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
  }

  .ai-social-media-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.item_gap }}px;
    padding: {{ block.settings.column_padding }}px;
    background-color: {{ block.settings.column_background }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: transform 0.2s ease;
  }

  .ai-social-media-column-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-social-media-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    flex-shrink: 0;
  }

  .ai-social-media-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-social-media-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-social-media-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-social-media-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_font_size }}px;
    font-weight: {{ block.settings.name_font_weight }};
    color: {{ block.settings.name_color }};
    margin: 0;
  }

  .ai-social-media-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.item_gap }}px;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-social-media-grid-{{ ai_gen_id }} {
      width: 100%;
      max-width: 100%;
      grid-template-columns: repeat(3, 1fr);
      gap: {{ block.settings.column_gap_mobile }}px;
      padding-right: 5%;
      padding-left: 5%;
    }

    .ai-social-media-column-{{ ai_gen_id }} {
      padding: {{ block.settings.column_padding_mobile }}px;
    }

    .ai-social-media-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_size_mobile }}px;
      height: {{ block.settings.image_size_mobile }}px;
    }

    .ai-social-media-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.name_font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-social-media-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-media-grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'social_' | append: i | append: '_image'
        assign name_key = 'social_' | append: i | append: '_name'
        assign url_key = 'social_' | append: i | append: '_url'
        
        assign social_image = block.settings[image_key]
        assign social_name = block.settings[name_key]
        assign social_url = block.settings[url_key]
      %}
      
      <div class="ai-social-media-column-{{ ai_gen_id }}">
        {% if social_url != blank %}
          <a href="{{ social_url }}" class="ai-social-media-link-{{ ai_gen_id }}" target="_blank" rel="noopener noreferrer">
            <div class="ai-social-media-image-wrapper-{{ ai_gen_id }}">
              {% if social_image %}
                <img
                  src="{{ social_image | image_url: width: 200 }}"
                  alt="{{ social_name | escape }}"
                  class="ai-social-media-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-social-media-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if social_name != blank %}
              <p class="ai-social-media-name-{{ ai_gen_id }}">{{ social_name }}</p>
            {% endif %}
          </a>
        {% else %}
          <div class="ai-social-media-image-wrapper-{{ ai_gen_id }}">
            {% if social_image %}
              <img
                src="{{ social_image | image_url: width: 200 }}"
                alt="{{ social_name | escape }}"
                class="ai-social-media-image-{{ ai_gen_id }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-social-media-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if social_name != blank %}
            <p class="ai-social-media-name-{{ ai_gen_id }}">{{ social_name }}</p>
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>


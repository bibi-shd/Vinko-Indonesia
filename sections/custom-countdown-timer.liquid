{%- style -%}
  .countdown-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .countdown-section-{{ section.id }} .countdown-wrapper {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    padding: 0 20px;
  }
  .countdown-section-{{ section.id }} .section-heading {
    font-size: {{ section.settings.heading_size }}px;
    margin-bottom: 8px;
  }
  .countdown-section-{{ section.id }} .section-subheading {
    color: rgba(var(--color-foreground), 0.6);
    font-size: 16px;
    margin-bottom: 36px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .countdown-section-{{ section.id }} .countdown-grid {
    display: flex;
    justify-content: center;
    gap: {{ section.settings.gap }}px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .countdown-section-{{ section.id }} .countdown-unit {
    {% if section.settings.card_style == 'bordered' %}
      border: 1px solid rgba(var(--color-foreground), 0.12);
      border-radius: {{ section.settings.card_radius }}px;
    {% elsif section.settings.card_style == 'filled' %}
      background: rgba(var(--color-foreground), 0.05);
      border-radius: {{ section.settings.card_radius }}px;
    {% endif %}
    min-width: {{ section.settings.unit_width }}px;
    padding: {{ section.settings.unit_padding }}px;
  }
  .countdown-section-{{ section.id }} .countdown-number {
    font-size: {{ section.settings.number_size }}px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 4px;
    font-variant-numeric: tabular-nums;
  }
  .countdown-section-{{ section.id }} .countdown-label {
    font-size: {{ section.settings.label_size }}px;
    color: rgba(var(--color-foreground), 0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .countdown-section-{{ section.id }} .countdown-cta {
    display: inline-block;
    padding: 14px 36px;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-radius: {{ section.settings.card_radius }}px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: opacity 0.2s;
  }
  .countdown-section-{{ section.id }} .countdown-cta:hover {
    opacity: 0.85;
  }
  .countdown-section-{{ section.id }} .countdown-expired {
    font-size: 20px;
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.5);
  }
{%- endstyle -%}

<div class="countdown-section-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="countdown-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="countdown-grid" id="countdown-{{ section.id }}">
      <div class="countdown-unit">
        <div class="countdown-number" data-days>00</div>
        <div class="countdown-label">{{ section.settings.label_days }}</div>
      </div>
      <div class="countdown-unit">
        <div class="countdown-number" data-hours>00</div>
        <div class="countdown-label">{{ section.settings.label_hours }}</div>
      </div>
      <div class="countdown-unit">
        <div class="countdown-number" data-minutes>00</div>
        <div class="countdown-label">{{ section.settings.label_minutes }}</div>
      </div>
      <div class="countdown-unit">
        <div class="countdown-number" data-seconds>00</div>
        <div class="countdown-label">{{ section.settings.label_seconds }}</div>
      </div>
    </div>

    <div class="countdown-expired" id="countdown-expired-{{ section.id }}" style="display:none;">
      {{ section.settings.expired_message }}
    </div>

    {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
      <a href="{{ section.settings.cta_link }}" class="countdown-cta">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var endDate = new Date('{{ section.settings.end_date }}T{{ section.settings.end_time }}:00').getTime();
    var el = document.getElementById('countdown-' + sectionId);
    var expiredEl = document.getElementById('countdown-expired-' + sectionId);

    function update() {
      var now = Date.now();
      var diff = endDate - now;
      if (diff <= 0) {
        el.style.display = 'none';
        expiredEl.style.display = 'block';
        return;
      }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      el.querySelector('[data-days]').textContent = String(d).padStart(2, '0');
      el.querySelector('[data-hours]').textContent = String(h).padStart(2, '0');
      el.querySelector('[data-minutes]').textContent = String(m).padStart(2, '0');
      el.querySelector('[data-seconds]').textContent = String(s).padStart(2, '0');
      requestAnimationFrame(function() { setTimeout(update, 1000); });
    }
    update();
  })();
</script>

{% schema %}
{
  "name": "Countdown Timer",
  "tag": "section",
  "class": "section-countdown",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sale Ends Soon"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Don't miss out on our biggest sale of the year"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date (YYYY-MM-DD)",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time (HH:MM, 24h)",
      "default": "23:59"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "This offer has ended."
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Minutes label",
      "default": "Minutes"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Seconds label",
      "default": "Seconds"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Number font size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "unit_width",
      "label": "Unit min width",
      "min": 60,
      "max": 140,
      "step": 10,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "unit_padding",
      "label": "Unit padding",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between units",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Unit style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "bordered", "label": "Bordered" },
        { "value": "filled", "label": "Filled" }
      ],
      "default": "bordered"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer",
      "category": "Promotion"
    }
  ]
}
{% endschema %}
